# diagnostics
# (none)

# ir
(function drops_infinite_loop
  (returns va)
  (body
    (usage a :write b :write)
    (assign
      (targets
        (tuple
          (name a :va)
          (name b :va)))
      (value
        (call-inet :arity 0 :sigs () :ret par[va, va])))
    (return !
      (var a :va))))

