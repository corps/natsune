# ir
(function simple_inverse_example
  (returns va)
  (body
    (usage a :write b :write)
    (assign
      (targets
        (name a :ref[va]))
      (value
        (dynamic :va
          (source "[]"))))
    (assign
      (targets
        (name b :inv[va]))
      (value
        (const 0 :va)))
    (exprstmt
      (dynamic :va
        (source "a.append(b)")
        (captures
          (a
            (var a :ref[va]))
          (b
            (var b :inv[va])))))
    (exprstmt
      (dynamic :va
        (source "a.append(b)")
        (captures
          (a
            (var a :ref[va]))
          (b
            (var b :inv[va])))))
    (assign
      (targets
        (name b :inv[va]))
      (value
        (const 5 :va)))
    (return !
      (var a :ref[va]))))

