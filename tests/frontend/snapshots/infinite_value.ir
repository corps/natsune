# diagnostics
# (none)

# ir
(function infinite_value
  (returns va)
  (body
    (usage a :write)
    (assign
      (targets
        (name a :va))
      (value
        (const 0 :va)))
    (while *
      (test
        (const True :va))
      (body
        (usage a :write)
        (augassign +
          (target
            (name a :va))
          (value
            (const 1 :va))))
      (orelse))
    (return !
      (var a :va))))

