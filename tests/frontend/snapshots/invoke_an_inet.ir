# diagnostics
# (none)

# ir
(function invoke_an_inet
  (returns va)
  (body
    (usage a :write b :write)
    (assign
      (targets
        (tuple
          (name a :va)
          (name b :va)))
      (value
        (call-inet :arity 1 :sigs (va) :ret par[va, va]
          (const 10 :va))))
    (return !
      (var a :va))))

